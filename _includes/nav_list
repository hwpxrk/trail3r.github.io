<!-- Render a nested sidebar navigation list. -->


<nav class="navigation_list">
    {% if page.sidebar.title %}
        <h3 class="navigation_title">{{ page.sidebar.title }}</h3>
    {% endif %}

    <input id="accordion_table_of_contents" name="accordion_table_of_contents" type="checkbox">
    <label for="accordion_table_of_contents">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>

    <ul class="navigation_items">
        {% for navigation_name in include.nav %}
            {% assign navigation_items = site.data.navigation[navigation_name] %}

            {% for navigation_item in navigation_items %}
                <li>
                    {% if navigation_item.url %}
                        <a href="{{ navigation_item.url | relative_url }}">
                            <span class="navigation_subtitle">{{ navigation_item.title }}</span>
                        </a>
                    {% else %}
                        <span class="navigation_subtitle">{{ navigation_item.title }}</span>
                    {% endif %}

                    {% if navigation_item.children %}
                        <ul>
                            {% for navigation_child in navigation_item.children %}
                                <li>
                                    <a {% if navigation_child.url == page.url %}class="is_active"{% endif %} href="{{ navigation_child.url | relative_url }}">
                                        {{ navigation_child.title }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        {% endfor %}
    </ul>
</nav>
