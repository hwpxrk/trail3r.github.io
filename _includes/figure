<!-- Render an image with an optional caption and lightbox. -->


<figure class="{{ include.class }}">
    {% if include.popup %}
        <a class="image_popup" href="{{ include.image_path | relative_url }}"{% if include.caption %} title="{{ include.caption | markdownify | strip_html | escape_once }}"{% endif %}>
    {% endif %}

    <img src="{{ include.image_path | relative_url }}" alt="{% if include.alt %}{{ include.alt | escape_once }}{% endif %}" loading="lazy" decoding="async">

    {% if include.popup %}
        </a>
    {% endif %}

    {% if include.caption %}
        <figcaption>
            {{ include.caption | markdownify | remove: "<p>" | remove: "</p>" }}
        </figcaption>
    {% endif %}
</figure>
